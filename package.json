{
  "name": "edenia",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-first language-learning progress app",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "build:production": "npm run build && node scripts/write-runtime-config.mjs --require-key",
    "dev": "node scripts/dev.mjs",
    "test": "npm run build && npm run test:contracts",
    "test:catalogs": "node scripts/validate-channel-catalog-json.mjs",
    "test:catalogs:discovery": "node scripts/validate-discovered-channel-catalog.mjs",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "test:ci": "npm run build && npm run test:contracts && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "esbuild": "0.28.1",
    "terser": "5.49.0"
  }
}
