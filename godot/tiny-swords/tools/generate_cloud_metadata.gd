extends SceneTree
# Authoring-time geometry. Keep the original pixel classification and float
# arithmetic used by cloud_visual.gd, but perform it once outside the game.
const OUTPUT := "res://assets/clouds/cloud_metadata.gd"

func _initialize() -> void:
	var variants: Array = []
	for index in range(1, 9):
		var original := Image.load_from_file("res://Tiny Swords (Free Pack)/Terrain/Decorations/Clouds/Clouds_%02d.png" % index)
		var body := Image.load_from_file("res://assets/clouds/Clouds_%02d_without_shadow.png" % index)
		if original == null or body == null:
			push_error("Missing cloud source image")
			quit(1)
			return
		var body_sum := Vector2.ZERO
		var shadow_sum := Vector2.ZERO
		var body_count := 0
		var shadow_count := 0
		for y in original.get_height():
			for x in original.get_width():
				var color := original.get_pixel(x, y)
				if color.a < 0.1:
					continue
				if color.get_luminance() < 0.52:
					shadow_sum += Vector2(x, y)
					shadow_count += 1
				else:
					body_sum += Vector2(x, y)
					body_count += 1
		if body_count == 0 or shadow_count == 0:
			push_error("Cloud source has no body or shadow")
			quit(1)
			return
		var offset := shadow_sum / shadow_count - body_sum / body_count
		var center := body_sum / body_count - Vector2(body.get_size()) / 2.0
		variants.append({
			"body_width": body.get_used_rect().size.x,
			"offset": [offset.x, offset.y],
			"center": [center.x, center.y]
		})
	var source := "# Generated by tools/generate_cloud_metadata.gd; regenerate after editing cloud PNGs.\nextends RefCounted\n\nconst VARIANTS := " + JSON.stringify(variants, "\t", true, true) + "\n"
	if "--check" in OS.get_cmdline_user_args():
		if FileAccess.get_file_as_string(OUTPUT) != source:
			push_error("Cloud geometry metadata is stale; run tools/generate_cloud_metadata.gd")
			quit(1)
			return
	else:
		var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
		if file == null:
			push_error("Could not write cloud geometry metadata")
			quit(1)
			return
		file.store_string(source)
	print("Cloud geometry metadata: PASS (8 variants)")
	quit()
